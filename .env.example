AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:1234
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=12000
AI_CUSTOM_INSTRUCTION=

# Lock AI settings in the UI/API when managed by deployment secrets.
AI_CONFIG_READONLY=false

# Metadata database: sqlite (default) or postgres. Files remain in data/uploads.
DATABASE_BACKEND=sqlite
# Set DATABASE_URL through your secret manager when DATABASE_BACKEND=postgres.
# DATABASE_URL=REPLACE_WITH_POSTGRES_CONNECTION_URI
# TLS: use sslmode=verify-full and sslrootcert=/path/to/ca.crt in DATABASE_URL.
OTEL_SDK_DISABLED=true
DO_NOT_TRACK=1
# When behind a trusted reverse proxy (block direct access):
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Private isolated renderer URL; never expose /render to users.
# MODEL_THUMBNAIL_URL=http://asset-library-renderer:8080

# Optional native OpenID Connect login (Authentik or another conforming IdP).
AUTH_MODE=none
# OIDC_ISSUER_URL=https://identity.example/application/o/asset-library/
# OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# ORIGIN=https://asset-library.example
OIDC_SESSION_MAX_AGE_SECONDS=3600
# Optional additional restriction based on signed ID-token groups:
# OIDC_ALLOWED_GROUPS=library-users,library-admins
# Optional Authentik-only internal transport; the public HTTPS issuer is still validated.
# OIDC_INTERNAL_ORIGIN=http://authentik-server.auth.svc.cluster.local
# Test-only HTTP: both issuer and app origin must be localhost/loopback.
# OIDC_ALLOW_HTTP_LOCALHOST=false
