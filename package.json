{
  "name": "asset-library",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-icons.mjs && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "prepare": "node scripts/build-icons.mjs && svelte-kit sync",
    "check": "node scripts/build-icons.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "node scripts/build-icons.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/mingcute": "1.2.8",
    "@iconify-json/codex": "1.2.0",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.103",
    "ai": "7.0.154",
    "fuse.js": "7.5.0",
    "image-size": "2.0.4",
    "pg": "8.23.1",
    "svelte-sonner": "1.2.2",
    "three": "0.186.1",
    "wavesurfer.js": "8.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
